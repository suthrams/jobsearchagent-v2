# Pin line-ending handling so it does not depend on each clone's core.autocrlf.
# Text files are stored as LF in the repository AND checked out as LF in the
# working tree on every platform (eol=lf), so Windows clones stop showing
# spurious CRLF-only modifications. Shell scripts and git hooks stay LF too.

* text=auto eol=lf

# Always LF in the working tree (executable / EOL-sensitive)
*.sh        text eol=lf
*.bash      text eol=lf
tools/git-hooks/*  text eol=lf

# Binary assets - never normalize or diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.db    binary
*.sqlite binary
