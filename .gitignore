# ─── Blog and article content ────────────────────────────────────────────────
# Article drafts, published versions, series plan, and image assets live in
# blogs/ and are intentionally not tracked. Move article files here before
# editing.
blogs/

# ─── Secrets & credentials ───────────────────────────────────────────────────
.env
.env.*
*.env

# ─── Personal data ────────────────────────────────────────────────────────────
# Your resume PDF — contains personal PII, never commit
resume.pdf
*.pdf

# Parsed resume profile — extracted from resume, contains name/email/work history
data/profile.json

# Job search database — contains your full search and application history
data/jobs.db
data/*.db
# SQLite write-ahead log artifacts that live next to the .db file
data/*.db-shm
data/*.db-wal
data/*.db-journal
# Timestamped DB backups taken before migrations (e.g. v2.db.bak-20260526-154813)
data/*.bak*

# Tailored resumes and run logs — contain personal content
output/

# ─── Streamlit ────────────────────────────────────────────────────────────────
# Contains auth tokens from streamlit login
.streamlit/credentials.toml

# ─── LinkedIn inbox ───────────────────────────────────────────────────────────
# Processed automatically — no need to commit, and may contain private URLs
inbox/linkedin.txt

# ─── Mermaid folder ───────────────────────────────────────────────────────────
# Processed automatically — no need to commit
mermaid/

# ─── Config (user-specific, never commit) ────────────────────────────────────
config/config.yaml

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/

