# ─── Blog and article content ────────────────────────────────────────────────
# Article drafts, published versions, series plan, and image assets live in
# blogs/ and are intentionally not tracked. Move article files here before
# editing.
blogs/

# ─── Secrets & credentials ───────────────────────────────────────────────────
.env
.env.*
*.env

# Cryptographic keys and certificates — NEVER commit
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.pkcs12
*.jks
*.keystore

# SSH keys (any path containing these in the filename)
**/id_rsa
**/id_rsa.*
**/id_dsa
**/id_dsa.*
**/id_ed25519
**/id_ed25519.*
**/id_ecdsa
**/id_ecdsa.*
**/*.ssh

# Cloud + tool credential conventions
**/credentials
**/credentials.json
**/credentials.toml
**/credentials.ini
**/credentials.yml
**/credentials.yaml
.aws/
.gcp/
.azure/
gcp-credentials.json
service-account*.json

# Generic secret-like patterns
*.secret
secrets.*
.secrets/

# ─── Personal data ────────────────────────────────────────────────────────────
# Your resume PDF — contains personal PII, never commit
resume.pdf
*.pdf

# ── data/ : default-deny, then allow the intentionally-tracked files ──────
# `data/` holds SQLite databases, exports (resume_clinic_validation outputs,
# vishal_export/, etc.), parsed profiles, and other PII. Default-deny means a
# new file landing in data/ stays local unless we explicitly un-ignore it.
data/*
# Allow-list: these are the only data/ files that ARE meant to be committed.
!data/linkedin_inbox.txt
!data/skills.yaml

# Tailored resumes and run logs — contain personal content
output/

# ─── Streamlit ────────────────────────────────────────────────────────────────
# Contains auth tokens from streamlit login
.streamlit/credentials.toml

# ─── LinkedIn inbox ───────────────────────────────────────────────────────────
# Processed automatically — no need to commit, and may contain private URLs
inbox/linkedin.txt

# ─── Mermaid folder ───────────────────────────────────────────────────────────
# Processed automatically — no need to commit
mermaid/

# ─── Config (user-specific, never commit) ────────────────────────────────────
config/config.yaml

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/

# ─── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Claude Code ──────────────────────────────────────────────────────────────
# Use `.claude/*` (not `.claude/`) so a re-include rule below can opt files
# back in - gitignore cannot un-exclude paths under a fully-excluded parent.
.claude/*
# Project-wide settings (hooks, permissions) MUST ship with the repo so the
# secret-audit rule travels to every clone. Personal overrides remain in
# .claude/settings.local.json (still ignored above).
!.claude/settings.json

# ─── Obsidian ─────────────────────────────────────────────────────────────────
.obsidian/

# ─── AI coding assistants — local config, never commit ───────────────────────
# Each tool drops its own dot-prefixed config dir at the project root. Listed
# explicitly (rather than `.[a-z]*/`) so legitimate dirs like .github/ stay
# committed.
.adal/
.agents/
.aider-desk/
.augment/
.bob/
.codeartsdoer/
.codebuddy/
.codemaker/
.codestudio/
.commandcode/
.continue/
.cortex/
.crush/
.devin/
.factory/
.forge/
.goose/
.iflow/
.junie/
.kilocode/
.kiro/
.kode/
.mcpjam/
.mux/
.neovate/
.openhands/
.pi/
.pochi/
.qoder/
.qwen/
.rovodev/
.tabnine/
.trae/
.vibe/
.windsurf/
.zencoder/

# ─── Agent skills pack ───────────────────────────────────────────────────────
# skills/ and skills-lock.json are project assets — committed so the team
# gets the same curated pack on clone. See skills/README.md for the index.

