# v2 Architecture — four layers (control, orchestration, execution, persistence)

direction: down

vars: {
  d2-config: {
    sketch: false
    pad: 40
  }
}

title: |md
  # v2 Architecture

  Four layers: control surface, orchestration, execution, persistence.
| {
  near: top-center
  shape: text
}

user: "User" {
  shape: oval
  style: {
    fill: "#0369a1"
    stroke: "#38bdf8"
    font-color: "#ffffff"
    bold: true
  }
}

control: "Control surface" {
  style: {
    fill: "#f0fdf4"
    stroke: "#16a34a"
    border-radius: 8
  }

  ui: "Streamlit UI\nstart runs, browse, drill in\nreads direct from DB" {
    style: {
      fill: "#dcfce7"
      stroke: "#16a34a"
      font-color: "#1e293b"
    }
  }
  api: "FastAPI\nvalidates every write\nstarts and resumes workflows" {
    style: {
      fill: "#dcfce7"
      stroke: "#16a34a"
      font-color: "#1e293b"
    }
  }
}

orchestration: "Orchestration" {
  style: {
    fill: "#fefce8"
    stroke: "#ca8a04"
    border-radius: 8
  }

  graph: "LangGraph\nowns WorkflowState\nonly the orchestrator mutates state" {
    style: {
      fill: "#fef9c3"
      stroke: "#ca8a04"
      font-color: "#1e293b"
    }
  }
  registry: "ModelRegistry\nper-agent provider + model\nresolved at run start" {
    style: {
      fill: "#fef9c3"
      stroke: "#ca8a04"
      font-color: "#1e293b"
    }
  }
}

execution: "Execution" {
  style: {
    fill: "#fdf2f8"
    stroke: "#a21caf"
    border-radius: 8
  }

  agents: "8 Specialized Agents\nPydantic in, Pydantic out\nno DB or filesystem access" {
    style: {
      fill: "#fce7f3"
      stroke: "#a21caf"
      font-color: "#1e293b"
    }
  }
  tailoring: "On-demand Tailoring\nout-of-graph operation\nTailoring + Fidelity Reviewer" {
    style: {
      fill: "#fce7f3"
      stroke: "#a21caf"
      font-color: "#1e293b"
    }
  }
}

persistence: "Persistence" {
  style: {
    fill: "#fffbeb"
    stroke: "#d97706"
    border-radius: 8
  }

  db: "v2.db\njobs, scores, reviews,\ntailorings, decisions" {
    shape: cylinder
    style: {
      fill: "#fef3c7"
      stroke: "#d97706"
      font-color: "#1e293b"
    }
  }
  saver: "SqliteSaver\nworkflow checkpoints\nresumable on crash" {
    shape: cylinder
    style: {
      fill: "#fef3c7"
      stroke: "#d97706"
      font-color: "#1e293b"
    }
  }
}

# Vertical flow
user -> control
control -> orchestration
orchestration -> execution
execution -> persistence
