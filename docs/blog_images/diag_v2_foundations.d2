# v2 Foundations Week — 5-day timeline of designing before any v2 code

direction: right

vars: {
  d2-config: {
    sketch: false
    pad: 40
  }
}

title: |md
  # v2 Foundations Week

  Patterns, ADRs, implementation plan, and skills inventory  -  before any v2 code.
| {
  near: top-center
  shape: text
}

day1: "Day 1\n\nPatterns + Principles\n\nwhat we keep\nwhat we forbid" {
  style: {
    fill: "#dbeafe"
    stroke: "#3b82f6"
    font-color: "#1e293b"
    border-radius: 8
  }
}

day2: "Day 2-3\n\n56 ADRs\n\neach decision with\nreasoning + tradeoff" {
  style: {
    fill: "#dbeafe"
    stroke: "#3b82f6"
    font-color: "#1e293b"
    border-radius: 8
  }
}

day3: "Day 3-4\n\nImplementation Plan\n\n8 phases\nwith review gates" {
  style: {
    fill: "#dbeafe"
    stroke: "#3b82f6"
    font-color: "#1e293b"
    border-radius: 8
  }
}

day4: "Day 4\n\nSkills Inventory\n\nwhich agentic skill\napplies where" {
  style: {
    fill: "#dbeafe"
    stroke: "#3b82f6"
    font-color: "#1e293b"
    border-radius: 8
  }
}

day5: "Day 5+\n\nFirst v2 code\n\nPhase 1 starts:\nschemas, repos, config" {
  style: {
    fill: "#dcfce7"
    stroke: "#16a34a"
    font-color: "#1e293b"
    border-radius: 8
  }
}

day1 -> day2 -> day3 -> day4 -> day5

footer: |md
  Four design artifacts in five days. Five documents that have informed every commit since.
| {
  near: bottom-center
  shape: text
}
