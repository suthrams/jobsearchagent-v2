# v2 HITL Evolution — as designed (two interrupts) vs as shipped (auto-gate + out-of-graph)

direction: right

vars: {
  d2-config: {
    sketch: false
    pad: 40
  }
}

title: |md
  # HITL Evolution

  Two human checkpoints inside the workflow graph were redesigned during the build.
| {
  near: top-center
  shape: text
}

before: "AS DESIGNED  -  two interrupts inside the graph" {
  style: {
    fill: "#fef2f2"
    stroke: "#dc2626"
    border-radius: 8
  }

  score1: "score_jobs\nscoring agent batch" {
    style: {
      fill: "#1e293b"
      stroke: "#38bdf8"
      font-color: "#f1f5f9"
    }
  }
  hitl1: "await_job_selection\nHITL #1: user picks jobs" {
    style: {
      fill: "#fee2e2"
      stroke: "#dc2626"
      font-color: "#991b1b"
      bold: true
    }
  }
  chain1: "deep_review + advice + tailoring\nagent chain" {
    style: {
      fill: "#1e293b"
      stroke: "#38bdf8"
      font-color: "#f1f5f9"
    }
  }
  hitl2: "await_tailoring_approval\nHITL #2: user approves draft" {
    style: {
      fill: "#fee2e2"
      stroke: "#dc2626"
      font-color: "#991b1b"
      bold: true
    }
  }
  report1: "generate_report\nfinal report" {
    style: {
      fill: "#1e293b"
      stroke: "#38bdf8"
      font-color: "#f1f5f9"
    }
  }

  score1 -> hitl1 -> chain1 -> hitl2 -> report1
}

after: "AS SHIPPED  -  auto-gate, tailoring out-of-graph" {
  style: {
    fill: "#f0fdf4"
    stroke: "#16a34a"
    border-radius: 8
  }

  score2: "score_jobs\nscoring agent batch" {
    style: {
      fill: "#1e293b"
      stroke: "#38bdf8"
      font-color: "#f1f5f9"
    }
  }
  auto: "auto_select_jobs\nthreshold-based gate" {
    style: {
      fill: "#dcfce7"
      stroke: "#16a34a"
      font-color: "#14532d"
      bold: true
    }
  }
  chain2: "deep_review + advice + interview_prep\nagent chain" {
    style: {
      fill: "#1e293b"
      stroke: "#38bdf8"
      font-color: "#f1f5f9"
    }
  }
  report2: "generate_report\nfinal report" {
    style: {
      fill: "#1e293b"
      stroke: "#38bdf8"
      font-color: "#f1f5f9"
    }
  }

  ondemand: "On-demand tailoring (out-of-graph)\nTailoring + Fidelity Reviewer\nuser decides via separate API endpoint" {
    style: {
      fill: "#fce7f3"
      stroke: "#db2777"
      font-color: "#831843"
    }
  }

  score2 -> auto -> chain2 -> report2
  ondemand -> report2: "API trigger" {
    style.stroke-dash: 3
  }
}

footer: |md
  Job-selection HITL replaced by a scoring threshold. Tailoring moved out-of-graph. The interrupt-resume capability is still in the codebase.
| {
  near: bottom-center
  shape: text
}
