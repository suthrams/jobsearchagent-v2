{
  "id": "architecture_overview",
  "outDir": "docs/architecture/images",
  "width": 1800,
  "height": 1320,
  "layout": "scene",
  "title": "Job Search Agent - end-to-end architecture",
  "headSub": "What you bring -> in-graph funnel -> on-demand operations -> serving and persistence.",
  "scene": {
    "viewBox": [0, 0, 1800, 1080],
    "zones": [
      {"x": 40, "y": 70, "w": 360, "h": 230, "accent": "gray", "dashed": true, "fill": true, "label": "What you bring"},
      {"x": 40, "y": 330, "w": 360, "h": 380, "accent": "gray", "dashed": true, "fill": true, "label": "Job sources"},
      {"x": 440, "y": 70, "w": 940, "h": 560, "accent": "blue", "dashed": false, "fill": true, "label": "LangGraph workflow - in-graph, no interrupt()"},
      {"x": 440, "y": 660, "w": 940, "h": 380, "accent": "amber", "dashed": true, "fill": true, "label": "On-demand - out-of-graph (ADR-055 / 066 / 085)"},
      {"x": 1420, "y": 70, "w": 340, "h": 970, "accent": "green", "dashed": false, "fill": true, "label": "Serving + persistence"}
    ],
    "nodes": [
      {"id": "resume", "x": 70, "y": 120, "w": 300, "h": 80, "accent": "gray", "icon": "doc", "title": "Resume PDF", "sub": "parsed -> profile"},
