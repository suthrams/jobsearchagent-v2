      {"id": "ui", "x": 1450, "y": 290, "w": 280, "h": 95, "accent": "blue", "icon": "table", "title": "Streamlit UI", "sub": "thin client (ADR-075)"},
      {"id": "ckpt", "x": 1450, "y": 470, "w": 280, "h": 95, "accent": "amber", "icon": "database", "title": "SqliteSaver", "sub": "checkpoints"},
      {"id": "db", "x": 1450, "y": 610, "w": 280, "h": 95, "accent": "amber", "icon": "database", "title": "SQLite", "sub": "runs, scores, costs"}
    ],
    "edges": [
      {"from": "resume:right", "to": "discover:left", "accent": "gray", "style": "thin"},
      {"from": "prefs:right", "to": "discover:left", "accent": "gray", "style": "thin"},
      {"from": "adzuna:right", "to": "discover:left", "accent": "blue", "style": "thin"},
      {"from": "linkedin:right", "to": "discover:left", "accent": "blue", "style": "thin"},
      {"from": "ats:right", "to": "discover:left", "accent": "green", "style": "thin"},

      {"from": "discover:right", "to": "relevance:left", "accent": "blue", "style": "thin"},
      {"from": "relevance:right", "to": "research:left", "accent": "blue", "style": "thin"},
      {"from": "research:bottom", "to": "score:top", "accent": "blue", "style": "thin"},
      {"from": "score:left", "to": "gate:right", "accent": "blue", "style": "thin"},
      {"from": "gate:left", "to": "critic:right", "accent": "magenta", "style": "thin", "label": "qualifies"},
      {"from": "critic:bottom", "to": "auditor:top", "accent": "magenta", "style": "thick", "dashed": true, "label": "reflect loop"},
      {"from": "auditor:right", "to": "advisor:left", "accent": "blue", "style": "thin"},
      {"from": "advisor:right", "to": "report:left", "accent": "blue", "style": "thin"},

      {"from": "tailoring:right", "to": "fidelity:left", "accent": "red", "style": "thin", "label": "always after"},
      {"from": "clinic:right", "to": "fidelity:top", "accent": "gray", "style": "thin", "dashed": true, "label": "rewrites"},

      {"from": "report:bottom", "to": "coach:right", "accent": "amber", "style": "thin", "dashed": true, "label": "user triggers"},
      {"from": "report:top", "to": "api:left", "accent": "blue", "style": "thin", "label": "final report"},
      {"from": "report:right", "to": "db:left", "accent": "amber", "style": "thin", "label": "persist run"},
      {"from": "score:right", "to": "ckpt:left", "accent": "gray", "style": "thin", "dashed": true, "label": "checkpoint"},
      {"from": "api:bottom", "to": "ui:top", "accent": "blue", "style": "thin", "label": "renders"}
    ],
    "labels": [
      {"x": 470, "y": 132, "text": "discover -> research -> score -> deep review -> advise -> report", "accent": "blue", "tag": true, "size": 15}
    ]
  },
  "takeaway": {"icon": "robot", "accent": "amber", "text": "The funnel runs {{blue:in-graph}} with no interrupt(); {{amber:tailoring, the Resume Clinic, and interview prep}} run {{amber:out-of-graph}} on demand; the {{red:Fidelity Reviewer}} polices every generated draft; and the UI is a pure {{green:client}} of the API (ADR-075)."}
}
