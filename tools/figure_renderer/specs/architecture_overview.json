      {"id": "adzuna", "x": 70, "y": 380, "w": 300, "h": 80, "accent": "blue", "icon": "globe", "title": "Adzuna API", "sub": "concurrent, 5 workers"},
      {"id": "linkedin", "x": 70, "y": 480, "w": 300, "h": 80, "accent": "blue", "icon": "globe", "title": "LinkedIn / custom URLs", "sub": "manual intake"},
      {"id": "ats", "x": 70, "y": 580, "w": 300, "h": 80, "accent": "green", "icon": "globe", "title": "ATS-direct", "sub": "Greenhouse, Lever (opt-in)"},

      {"id": "discover", "x": 470, "y": 150, "w": 270, "h": 95, "accent": "blue", "icon": "steps", "title": "Discover + filter", "sub": "keyword gate"},
      {"id": "relevance", "x": 770, "y": 150, "w": 270, "h": 95, "accent": "green", "icon": "filter", "title": "Relevance Filter", "sub": "opt-in (ADR-079)"},
