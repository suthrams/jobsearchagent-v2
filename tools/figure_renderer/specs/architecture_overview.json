      {"id": "critic", "x": 470, "y": 300, "w": 270, "h": 95, "accent": "magenta", "icon": "pen", "title": "Resume Critic", "sub": "high-match jobs only"},

      {"id": "auditor", "x": 470, "y": 450, "w": 270, "h": 95, "accent": "magenta", "icon": "check", "title": "Review Auditor", "sub": "evaluator"},
      {"id": "advisor", "x": 770, "y": 450, "w": 270, "h": 95, "accent": "blue", "icon": "chart", "title": "Career Advisor", "sub": "advisory"},
      {"id": "report", "x": 1070, "y": 450, "w": 270, "h": 95, "accent": "blue", "icon": "doc", "title": "Generate Report", "sub": "terminal node"},

      {"id": "coach", "x": 470, "y": 720, "w": 420, "h": 90, "accent": "blue", "icon": "target", "title": "Interview Coach", "sub": "on-demand (ADR-085)"},
      {"id": "clinic", "x": 470, "y": 825, "w": 420, "h": 90, "accent": "amber", "icon": "doc", "title": "Resume Clinic", "sub": "review / chat / export"},
      {"id": "tailoring", "x": 470, "y": 930, "w": 420, "h": 90, "accent": "amber", "focal": true, "icon": "edit", "title": "Tailoring Agent", "sub": "evidence-bound generation"},
