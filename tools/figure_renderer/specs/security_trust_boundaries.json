{
  "id": "security_trust_boundaries",
  "outDir": "docs/architecture/images",
  "width": 1900,
  "height": 720,
  "layout": "scene",
  "title": "Trust boundaries: untrusted text reasons through the LLM, only validated output crosses back",
  "headSub": "Job descriptions and scraped pages are untrusted input. They reach the model as data to reason over, never as instructions to follow.",
  "scene": {
    "viewBox": [0, 0, 1900, 520],
    "zones": [
      {"x": 555, "y": 150, "w": 270, "h": 250, "accent": "red", "dashed": true, "fill": true, "label": "UNTRUSTED ZONE"},
      {"x": 1335, "y": 150, "w": 510, "h": 250, "accent": "green", "dashed": true, "fill": true, "label": "TRUSTED ZONE"}
    ],
    "nodes": [
      {"id": "user",    "x": 55,   "y": 200, "w": 230, "h": 150, "accent": "gray",  "icon": "user",     "title": "User input", "sub": "trusted but unverified"},
      {"id": "sys",     "x": 315,  "y": 200, "w": 230, "h": 150, "accent": "gray",  "icon": "steps",    "title": "System input layer", "sub": "intake"},
      {"id": "untrust", "x": 575,  "y": 200, "w": 230, "h": 150, "accent": "red",   "icon": "alert",    "title": "Untrusted input", "sub": "job descriptions, scraped pages"},
      {"id": "proc",    "x": 835,  "y": 200, "w": 230, "h": 150, "accent": "blue",  "icon": "filter",   "title": "Controlled processing", "sub": "normalize, parse"},
      {"id": "llm",     "x": 1095, "y": 200, "w": 230, "h": 150, "accent": "amber", "icon": "robot",    "title": "LLM boundary", "sub": "reasoning only", "focal": true},
      {"id": "trust",   "x": 1355, "y": 200, "w": 230, "h": 150, "accent": "green", "icon": "check",    "title": "Trusted zone", "sub": "validated, structured state"},
      {"id": "persist", "x": 1615, "y": 200, "w": 230, "h": 150, "accent": "green", "icon": "database", "title": "Persistence", "sub": "SQLite"}
    ],
    "edges": [
      {"from": "user:right",    "to": "sys:left",     "accent": "gray"},
      {"from": "sys:right",     "to": "untrust:left", "accent": "gray"},
      {"from": "untrust:right", "to": "proc:left",    "accent": "red"},
      {"from": "proc:right",    "to": "llm:left",     "accent": "blue", "style": "thick"},
      {"from": "llm:right",     "to": "trust:left",   "accent": "green", "style": "thick", "label": "validated only"},
      {"from": "trust:right",   "to": "persist:left", "accent": "green"}
    ]
  },
  "takeaway": {"icon": "shield", "accent": "green", "text": "Untrusted text only ever reaches the model as {{amber:data to reason over}}, never as instructions to follow - and only {{green:validated, structured output}} crosses into the trusted zone and the database."}
}
